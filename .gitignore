# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local environment files (machine-specific; use .env.example as the template)
.env
.env.local
.env.*.local
!.env.example

# Big data files and local outputs
data/raw/
data/processed/
output/
spark-warehouse/
*.csv
*.parquet
*.zip
*.gz

# Small sample files may be committed intentionally.
!data/sample/
!data/sample/**

# Pre-aggregated dashboard data (small derived outputs, not raw data).
!dashboard/assets/
!dashboard/assets/*.json

# OS/editor files
.DS_Store
.idea/
.vscode/
