# Copy this file to .env and set the two paths for your machine.
# Both are bind-mounted into the Spark containers by docker-compose.yml.

# Directory holding the raw AIS (.csv.zst) input files.
RAW_DATA_DIR=./data/raw/ais

# Directory for processed Parquet outputs (also used for Spark shuffle spill).
PROCESSED_DATA_DIR=./data/processed
